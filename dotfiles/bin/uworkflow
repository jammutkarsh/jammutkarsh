#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
	echo "Usage: $0 <dev|dev1|dev2>"
	exit 1
fi

TARGET="$1"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Find the workflow files: <target>-*.yml and <target>-*.yaml
shopt -s nullglob
FILES=(.github/workflows/"${TARGET}"-*.yml .github/workflows/"${TARGET}"-*.yaml)

if [[ ${#FILES[@]} -eq 0 ]]; then
	echo "❌ No workflow file found for: $TARGET"
	exit 1
fi

echo "Found workflow: ${FILES[*]}"
echo "Updating branch → $CURRENT_BRANCH"

for f in "${FILES[@]}"; do
	yq -i ".on.push.branches = [\"$CURRENT_BRANCH\"]" "$f"
done

echo "✅ Workflow updated"

# git add + commit + push
git add "${FILES[@]}"

COMMIT_MSG="ci: trigger ${TARGET}"
echo "Committing: $COMMIT_MSG"

git commit -m "$COMMIT_MSG"

echo "Pushing branch: $CURRENT_BRANCH"
git push origin "$CURRENT_BRANCH"

echo "✅ Pushed successfully"
