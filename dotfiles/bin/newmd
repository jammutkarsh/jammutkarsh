#!/usr/bin/env bash

url="$1"

# Remove protocol (https:// or http://)
name=$(echo "$url" | sed -E 's|^https?://||')

# Remove trailing slash
name="${name%/}"

# Replace all remaining slashes with hyphens
name="${name//\//-}"

# Remove query strings and fragments
name=$(echo "$name" | sed -E 's/[?#].*$//')

# Create the file
touch "${name}.md"

echo "Created: ${name}.md"
