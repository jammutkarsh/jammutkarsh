# Homebrew: Apple silicon, Intel macOS, Linuxbrew
for b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x $b ]]; then eval "$($b shellenv)"; break; fi
done

# PATH additions, only where the directory exists
[[ -d ${HOMEBREW_PREFIX:-/nonexistent}/opt/curl/bin ]] && path=($HOMEBREW_PREFIX/opt/curl/bin $path)
path=($HOME/.local/bin $path)

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

plugins=(
        git
        golang
        docker
        zsh-autosuggestions
        zsh-syntax-highlighting
        npm
        node
)

# ZSH Configs
export ZSH="$HOME/.oh-my-zsh"
export ZSH_COMPLETION="$HOME/.oh-my-zsh/completions/"

ZSH_THEME="uc_custom"
source $ZSH/oh-my-zsh.sh

autoload -U compinit && compinit

# Go Configs
export GOPATH="$HOME/go"
export PATH=$PATH:$HOME/go/bin

# Personal Configs (DOTFILES = repo root, resolved through the ~/.zshrc symlink)
export DOTFILES=${${(%):-%x}:A:h:h}
source $DOTFILES/zsh/aliases.zsh
export PATH=$PATH:$DOTFILES/bin

# History Configs
HISTSIZE=50000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups


# Misc Configs

#CMD: Raycast
export EDITOR=vim

#CMD: atuin or ctrl + r
# replacement for custom hst commanbd; https://github.com/atuinsh/atuin
if command -v atuin >/dev/null; then
  source <(atuin gen-completions --shell zsh)
  eval "$(atuin init zsh --disable-up-arrow)"
fi
test -e $HOME/.iterm2_shell_integration.zsh && source $HOME/.iterm2_shell_integration.zsh || true
